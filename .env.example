# Chave de API do provedor de texto (agentes editoriais).
# Deixe em branco para rodar em MODO DEMONSTRAÇÃO (dados mockados, sem custo, sem chave).
AI_API_KEY=

# Modelo a usar quando AI_API_KEY estiver configurada (opcional).
# Padrão: claude-sonnet-4-5
AI_MODEL=

# Chave de API do provedor de imagens (ilustrações/fotografias de fundo).
# Ainda não usada nesta versão — reservada para o próximo provedor de imagem.
IMAGE_API_KEY=

# --- Armazenamento em produção (opcional) ---
# Em branco, o app usa arquivos JSON em data/ — funciona local, mas não
# persiste em hospedagens serverless (ex.: Vercel), cujo sistema de arquivos
# é somente leitura. Adicione as integrações "Redis" e "Blob" pelo dashboard
# da Vercel (aba Storage) e essas variáveis são preenchidas automaticamente.
KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=
